:root {
  --background-color: oklch(97% 0.001 106.424);
  --background-color-card: oklch(98.5% 0.001 106.423);
  --background-color-card-hover: oklch(75.402% 0.00009 271.152);
  --background-color-button: oklch(90.295% 0.00324 15.477);
  --color: oklch(14.7% 0.004 49.25);
  --color-a: oklch(59.336% 0.15058 245.389 / 0.93);
  --color-heading: oklch(37.2% 0.044 257.287);
  --color-tag: oklch(37.4% 0.01 67.558);
  --color-footer:rgb(122, 122, 122);
  --shadow-post: 0px 4px 8px rgba(0, 0, 0, 0.04), 0px 0px 2px rgba(0, 0, 0, 0.06), 0px 0px 1px rgba(0, 0, 0, 0.04);
  --border-radius-default: 24px;
  --border-radius-button: 6px;
  --color-border-active: oklch(36.002% 0.00004 271.152);
  --color-border-disabled: oklch(93.535% 0.03084 271.714); }

@media (prefers-color-scheme: dark) {
  :root {
    --background-color: oklch(21% 0.006 285.885);
    --background-color-card: oklch(37% 0.013 285.805);
    --background-color-card-hover: oklch(44.226% 0.00005 271.152);
    --background-color-button: oklch(32.245% 0.01071 278.234);
    --color: oklch(98.5% 0.001 106.423);
    --color-a: oklch(80.9% 0.105 251.813);
    --color-heading: oklch(98.5% 0.001 106.423);
    --color-tag: oklch(95.6% 0.045 203.388);
    --color-footer:oklch(98.5% 0.001 106.423);
    --shadow-post: 0px 4px 8px rgba(0, 0, 0, 0.04), 0px 0px 2px rgba(0, 0, 0, 0.06), 0px 0px 1px rgba(0, 0, 0, 0.04);
    --border-radius-default: 24px;
    --border-radius-button: 6px;
    --color-border-active: oklch(36.002% 0.00004 271.152);
    --color-border-disabled: oklch(93.535% 0.03084 271.714); } }

@media (max-width: 768px) {
  .menu_pc {
    display: none !important; }
  .menu_mobile {
    display: flex;
    flex-direction: column; }
  .menu_mobile_list {
    width: 100%; }
  nav ul li {
    margin-block: auto;
    padding-bottom: 1rem;
    list-style: none; } }

@media (min-width: 769px) {
  .menu_mobile {
    display: none !important; } }

.menu_mobile_list {
  display: none; }

html {
  scrollbar-gutter: stable; }

body {
  color: var(--color);
  font-family: sans-serif, Arial;
  line-height: 1.5;
  margin: auto;
  padding: 0 1rem;
  max-width: 768px;
  background-color: var(--background-color); }

header {
  margin-bottom: 1rem; }

footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-block: 1rem; }

footer p {
  color: var(--color-footer);
  margin: 0.25rem;
  font-size: small; }

a {
  color: var(--color-a);
  text-decoration: none; }

a:hover {
  text-decoration: underline; }

.menu_pc nav ul {
  list-style: none;
  display: flex;
  align-items: center; }

nav ul li {
  margin-block: auto;
  padding-left: 2rem; }

h1, h2, h3, h4, h5, h6 {
  color: var(--color-heading); }

h1.title {
  font-size: large;
  padding-block: 1rem;
  margin-block: 0.25rem;
  color: var(--color-heading); }

audio {
  width: 100%;
  margin-top: 1rem; }

div.card, div.page {
  margin-block: 1rem;
  padding: 1rem;
  background-color: var(--background-color-card);
  border-radius: var(--border-radius-default);
  box-shadow: var(--shadow-post); }

div.menu_mobile {
  margin-block: 1rem;
  padding: 1rem;
  background-color: var(--background-color-card);
  border-radius: var(--border-radius-default);
  box-shadow: var(--shadow-post);
  display: flex;
  align-items: center; }

.license {
  font-weight: bold; }

.terms-of-service {
  font-weight: bold;
  font-size: large; }

div .grid-container {
  display: flex;
  flex-wrap: wrap; }

div .grid-license {
  align-items: center;
  justify-content: center;
  display: flex; }

div .center {
  text-align: center; }

.grid-container div {
  margin: auto; }

span.tag {
  display: inline-block;
  font-weight: 600;
  font-size: small;
  margin-bottom: 1rem; }

span.download {
  display: inline-block;
  background-color: var(--background-color-button);
  border-radius: var(--border-radius-button);
  padding: 0.5rem;
  margin-block: 0.5rem;
  margin-inline: 0.2rem;
  font-size: normal; }

span.download:hover {
  background-color: var(--background-color-card-hover);
  transition: background-color 0.3s; }

span.tag a, span.download a, ul.label a {
  color: var(--color-tag); }

ul.label {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  list-style: none;
  margin-block-start: 1rem;
  padding-inline-start: 0; }

ul.label li {
  padding: 0.4rem;
  border-radius: var(--border-radius-button);
  background-color: var(--background-color-button); }

ul.label li:hover {
  background-color: var(--background-color-card-hover);
  transition: background-color 0.3s; }

/* pager */
.pager ul {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 0;
  margin: 40px 0;
  gap: 10px; }

.pager li {
  display: inline-block; }

.pager a {
  text-decoration: none;
  padding: 8px 16px;
  border: 1px solid #ddd;
  border-radius: var(--border-radius-button);
  color: var(--color);
  transition: all 0.2s;
  background-color: var(--background-color-card); }

.pager a:hover {
  background-color: var(--background-color-card);
  border-color: var(background-color-card-hover); }

.pager li.active a {
  background-color: #000;
  color: #fff;
  border-color: var(--color-border-active); }

.pager li.disabled a {
  color: #ccc;
  pointer-events: none;
  border-color: var(--color-border-disabled); }

/* --- Language Switcher Styles --- */
/* 1. Outer Container (Track) */
.lang-switch {
  position: relative;
  display: flex;
  align-items: center;
  width: 120px;
  /* Width, adjustable */
  height: 36px;
  /* Height */
  background-color: #e5e7eb;
  /* Light gray background */
  border-radius: 9999px;
  /* Fully rounded corners */
  padding: 4px;
  /* Padding */
  cursor: pointer;
  user-select: none;
  text-decoration: none;
  /* Remove underline */
  transition: background-color 0.3s; }

/* 2. Slider (White rounded background) */
.switch-slider {
  position: absolute;
  top: 4px;
  bottom: 4px;
  left: 4px;
  width: calc(50% - 4px);
  /* Width minus padding */
  background-color: white;
  border-radius: 9999px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  /* Smooth transition animation */
  z-index: 1; }

/* 3. General Text Styles */
.lang-text {
  position: relative;
  z-index: 2;
  /* Must be higher than the slider to display on top */
  flex: 1;
  /* Split width equally */
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  transition: color 0.3s;
  line-height: 1; }

/* --- State Control Logic --- */
/* Scenario A: Current is Japanese (Default State) */
.lang-switch.current-ja .switch-slider {
  transform: translateX(0);
  /* Slider on the left */ }

.lang-switch.current-ja .text-ja {
  color: #f43f5e;
  /* Rose Red (Active/Highlight) */ }

.lang-switch.current-ja .text-en {
  color: #9ca3af;
  /* Gray (Inactive) */ }

/* Scenario B: Current is English */
.lang-switch.current-en .switch-slider {
  transform: translateX(100%);
  /* Slider slides to the right */ }

.lang-switch.current-en .text-ja {
  color: #9ca3af;
  /* Gray (Inactive) */ }

.lang-switch.current-en .text-en {
  color: #f43f5e;
  /* Rose Red (Active/Highlight) */ }

/* --- (Optional) Dark Mode Support --- */
/* Use this if your site has class="dark" on body or relies on media queries */
@media (prefers-color-scheme: dark) {
  .lang-switch {
    background-color: #374151;
    /* Dark gray background */ }
  .switch-slider {
    background-color: #4b5563;
    /* Darker slider color */
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); } }
